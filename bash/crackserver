#!/bin/bash
set -euo pipefail

APP_ROOT="${HASHCAT_WPA_APP_ROOT:-/opt/hashcat-wpa-server}"
APP_USER="${HASHCAT_WPA_APP_USER:-hashcat}"
DATA_DIR="${HASHCAT_WPA_DATA_DIR:-/var/lib/hashcat-wpa-server}"
LOG_DIR="${HASHCAT_WPA_LOG_DIR:-/var/log/hashcat-wpa-server}"
SERVICE_NAME="${HASHCAT_WPA_SERVICE_NAME:-hashcat-wpa-server.service}"
DEFAULT_URL="http://127.0.0.1:9111"
NONE_VALUE="None"
DEFAULT_WORKLOAD="3"
DEFAULT_BRAIN_FEATURE="2"
CRITICAL_RESET_PATHS=(
    /
    /bin
    /boot
    /dev
    /etc
    /home
    /lib
    /lib64
    /opt
    /proc
    /root
    /run
    /sbin
    /sys
    /tmp
    /usr
    /usr/local
    /var
    /var/lib
    /var/log
)

script_path() {
    echo "$APP_ROOT/bash/$1"
}

need_installed() {
    if [ ! -d "$APP_ROOT" ]; then
        echo "[!] Hashcat WPA Server is not installed at $APP_ROOT."
        echo "    Install it first with:"
        echo "    curl -sL https://raw.githubusercontent.com/EpicNori/Hashcat-Pwnagotchi-server/main/install.sh | sudo bash"
        exit 1
    fi
}

run_as_app_user() {
    if id "$APP_USER" >/dev/null 2>&1; then
        sudo -u "$APP_USER" env HASHCAT_WPA_SKIP_STARTUP_MAINTENANCE=1 "$@"
    else
        env HASHCAT_WPA_SKIP_STARTUP_MAINTENANCE=1 "$@"
    fi
}

python_app() {
    need_installed
    if [ ! -x "$APP_ROOT/venv/bin/python" ]; then
        echo "[!] Python venv is missing at $APP_ROOT/venv/bin/python."
        exit 1
    fi
    cd "$APP_ROOT"
    run_as_app_user "$APP_ROOT/venv/bin/python" "$@"
}

dashboard_urls() {
    local ip
    ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
    echo "====================================================="
    echo "  Hashcat WPA Server Dashboard"
    echo "====================================================="
    echo "  Local:   http://127.0.0.1:9111"
    if [ -n "$ip" ]; then
        echo "  Network: http://${ip}:9111"
    fi
    echo "====================================================="
}

confirm() {
    local prompt="$1"
    local default="${2:-n}"
    local reply
    read -r -p "$prompt " reply
    reply="${reply:-$default}"
    [[ "$reply" =~ ^[Yy]$ ]]
}

require_option_value() {
    local option="$1"
    local value="${2:-}"
    if [ -z "$value" ]; then
        echo "[!] ${option} requires a value."
        exit 2
    fi
}

normalize_path_for_guard() {
    local path="$1"
    while [ "${#path}" -gt 1 ] && [ "${path%/}" != "$path" ]; do
        path="${path%/}"
    done
    printf '%s' "$path"
}

assert_safe_data_dir() {
    local path="${1:-}"
    local normalized
    local critical_path
    if [ -z "$path" ]; then
        echo "[!] Refusing to reset unsafe data path: '<empty>'"
        exit 1
    fi
    normalized="$(normalize_path_for_guard "$path")"
    if [[ "$normalized" != /* ]]; then
        echo "[!] Refusing to reset non-absolute data path: '$path'"
        exit 1
    fi
    for critical_path in "${CRITICAL_RESET_PATHS[@]}"; do
        if [ "$normalized" = "$critical_path" ]; then
            echo "[!] Refusing to reset unsafe data path: '$normalized'"
            exit 1
        fi
    done
}

trim_value() {
    local value="$1"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    printf '%s' "$value"
}

normalize_workload() {
    local value
    value="$(trim_value "${1:-}")"
    case "${value,,}" in
        ""|normal|default|wordlist|3)
            echo "$DEFAULT_WORKLOAD"
            ;;
        rainbow|pmk|4)
            echo "4"
            ;;
        *)
            echo "[!] Unknown workload: ${1}" >&2
            echo "    Use 'normal', 'rainbow', '3', or '4'." >&2
            exit 2
            ;;
    esac
}

truthy() {
    case "${1,,}" in
        1|true|yes|y|on) return 0 ;;
        *) return 1 ;;
    esac
}

append_devices_csv() {
    local csv="$1"
    local -n target_ref="$2"
    local part
    local -a parts=()
    local IFS=','
    read -r -a parts <<< "$csv"
    for part in "${parts[@]}"; do
        part="$(trim_value "$part")"
        if [ -n "$part" ]; then
            target_ref+=("$part")
        fi
    done
}

set_login() {
    need_installed
    local username="${1:-}"
    local password="${2:-}"
    if [ -z "$username" ]; then
        read -r -p "Admin username [admin]: " username
        username="${username:-admin}"
    fi
    if [ -z "$password" ]; then
        read -r -s -p "Admin password: " password
        echo
    fi
    if [ -z "$password" ]; then
        echo "[!] Password cannot be empty."
        exit 2
    fi

    printf '%s' "$password" | python_app -c '
import sys
from app import app, db
from app.login import Role, RoleEnum, User, create_first_users

username = sys.argv[1]
password = sys.stdin.read()

with app.app_context():
    create_first_users()
    user = User.query.filter_by(username=username).first()
    if user is None:
        user = User(username=username)
        db.session.add(user)
    user.set_password(password)
    required_roles = [Role.by_enum(RoleEnum.ADMIN), Role.by_enum(RoleEnum.USER)]
    user.roles = [role for role in required_roles if role is not None]
    db.session.commit()
    print(f"[+] Admin login ready: {username}")
' "$username"
}

show_upload_help() {
    cat <<'EOF'
Usage: crackserver upload [options] <capture...>

Connection:
  --url URL                   Default: http://127.0.0.1:9111
  --user USER                 Default: admin
  --password PASSWORD         Otherwise prompted
  --password=PASSWORD         Safest form for shell-special passwords

Job:
  --wordlist SERVER_PATH      Server-side wordlist path, or None
  --rule RULE                 Rule name such as best64.rule, or None
  --workload normal|rainbow   Default: normal
  --brain                     Enable Hashcat Brain for this upload
  --brain-feature 1|2|3       Default: 2
  --device ID                 Repeat for multiple Hashcat device IDs
  --devices ID,ID             Comma-separated Hashcat device IDs
EOF
}

upload_files() {
    local url="${CRACKSERVER_URL:-$DEFAULT_URL}"
    local username="${CRACKSERVER_USER:-admin}"
    local password="${CRACKSERVER_PASSWORD:-}"
    local wordlist="${CRACKSERVER_WORDLIST:-$NONE_VALUE}"
    local rule="${CRACKSERVER_RULE:-$NONE_VALUE}"
    local workload="${CRACKSERVER_WORKLOAD:-$DEFAULT_WORKLOAD}"
    local brain="${CRACKSERVER_BRAIN:-0}"
    local brain_feature="${CRACKSERVER_BRAIN_CLIENT_FEATURE:-$DEFAULT_BRAIN_FEATURE}"
    local files=()
    local devices=()

    if [ -n "${CRACKSERVER_DEVICES:-}" ]; then
        append_devices_csv "$CRACKSERVER_DEVICES" devices
    fi

    while [ "$#" -gt 0 ]; do
        case "$1" in
            -h|--help)
                show_upload_help
                return 0
                ;;
            --url=*)
                url="${1#--url=}"
                require_option_value "--url" "$url"
                shift
                ;;
            --url)
                require_option_value "$1" "${2:-}"
                url="${2:-}"
                shift 2
                ;;
            --user=*)
                username="${1#--user=}"
                require_option_value "--user" "$username"
                shift
                ;;
            --user)
                require_option_value "$1" "${2:-}"
                username="${2:-}"
                shift 2
                ;;
            --password=*)
                password="${1#--password=}"
                require_option_value "--password" "$password"
                shift
                ;;
            --password)
                require_option_value "$1" "${2:-}"
                password="${2:-}"
                shift 2
                ;;
            --wordlist=*)
                wordlist="${1#--wordlist=}"
                require_option_value "--wordlist" "$wordlist"
                shift
                ;;
            --wordlist)
                require_option_value "$1" "${2:-}"
                wordlist="${2:-}"
                shift 2
                ;;
            --rule=*)
                rule="${1#--rule=}"
                require_option_value "--rule" "$rule"
                shift
                ;;
            --rule)
                require_option_value "$1" "${2:-}"
                rule="${2:-}"
                shift 2
                ;;
            --workload=*)
                workload="$(normalize_workload "${1#--workload=}")"
                shift
                ;;
            --workload)
                require_option_value "$1" "${2:-}"
                workload="$(normalize_workload "${2:-}")"
                shift 2
                ;;
            --brain)
                brain="1"
                shift
                ;;
            --no-brain)
                brain="0"
                shift
                ;;
            --brain-feature=*|--brain-client-feature=*)
                brain_feature="${1#*=}"
                require_option_value "--brain-feature" "$brain_feature"
                shift
                ;;
            --brain-feature|--brain-client-feature)
                require_option_value "$1" "${2:-}"
                brain_feature="${2:-}"
                shift 2
                ;;
            --device=*)
                require_option_value "--device" "${1#--device=}"
                devices+=("${1#--device=}")
                shift
                ;;
            --device)
                require_option_value "$1" "${2:-}"
                devices+=("${2:-}")
                shift 2
                ;;
            --devices=*)
                require_option_value "--devices" "${1#--devices=}"
                append_devices_csv "${1#--devices=}" devices
                shift
                ;;
            --devices)
                require_option_value "$1" "${2:-}"
                append_devices_csv "${2:-}" devices
                shift 2
                ;;
            --)
                shift
                while [ "$#" -gt 0 ]; do
                    files+=("$1")
                    shift
                done
                ;;
            -*)
                echo "[!] Unknown upload option: $1"
                exit 2
                ;;
            *)
                files+=("$1")
                shift
                ;;
        esac
    done

    if [ "${#files[@]}" -eq 0 ]; then
        show_upload_help
        exit 2
    fi
    if [ -z "$password" ]; then
        read -r -s -p "Password for ${username}: " password
        echo
    fi

    workload="$(normalize_workload "$workload")"

    local curl_args=(-F "wordlist=${wordlist}" -F "rule=${rule}" -F "workload=${workload}" -F "brain_client_feature=${brain_feature}")
    if truthy "$brain"; then
        curl_args+=(-F "brain=y")
    fi
    local device
    for device in "${devices[@]}"; do
        device="$(trim_value "$device")"
        if [ -n "$device" ]; then
            curl_args+=(-F "devices=${device}")
        fi
    done
    for file in "${files[@]}"; do
        if [ ! -f "$file" ]; then
            echo "[!] Capture not found: $file"
            exit 2
        fi
        curl_args+=(-F "capture=@${file}")
    done

    curl -fS --user "${username}:${password}" "${curl_args[@]}" "${url%/}/api/upload"
    echo
}

tailscale_connect() {
    need_installed
    local auth_key="${1:-}"
    sudo -v
    if [ -z "$auth_key" ]; then
        read -r -s -p "Tailscale auth key (blank if already configured): " auth_key
        echo
    fi
    printf '%s' "$auth_key" | sudo "$(script_path install_tailscale.sh)"
}

cloudflare_connect() {
    need_installed
    local hostname="${1:-}"
    local token="${2:-}"
    sudo -v
    if [ -z "$hostname" ]; then
        read -r -p "Public hostname, e.g. upload.example.com: " hostname
    fi
    if [ -z "$token" ]; then
        read -r -s -p "Cloudflare Tunnel token: " token
        echo
    fi
    if [ -z "$hostname" ] || [ -z "$token" ]; then
        echo "[!] Hostname and Cloudflare token are required."
        exit 2
    fi
    printf '%s' "$token" | sudo "$(script_path install_cloudflare_tunnel.sh)" "$hostname"
    echo "[+] Pwnagotchi plugin URL: https://${hostname}"
}

setup_wizard() {
    need_installed
    echo "====================================================="
    echo "  Hashcat WPA Server Setup"
    echo "====================================================="
    dashboard_urls

    if confirm "Set or reset the admin login now? [y/N]" "n"; then
        set_login
    fi

    if confirm "Enable autostart on boot? [Y/n]" "y"; then
        sudo "$(script_path autostart_service.sh)" enable || echo "[!] Autostart could not be enabled on this host."
    fi

    if confirm "Check NVIDIA/AMD GPU driver readiness now? [Y/n]" "y"; then
        sudo "$(script_path install_gpu_drivers.sh)" check
    fi

    echo ""
    echo "Remote access:"
    echo "  1) Skip"
    echo "  2) Tailscale private VPN"
    echo "  3) Cloudflare Public Website"
    read -r -p "Choose [1]: " remote_choice
    case "${remote_choice:-1}" in
        2) tailscale_connect ;;
        3) cloudflare_connect ;;
        *) echo "[*] Remote access skipped." ;;
    esac

    echo ""
    echo "[*] Running doctor..."
    sudo -u "$APP_USER" "$(script_path verify_runtime.sh)" || true
    echo ""
    dashboard_urls
    echo "[+] Setup wizard finished."
}

show_help() {
    cat <<'EOF'
Usage: crackserver <command> [options]

Setup:
  setup                         Run the interactive launch setup wizard
  set-login [username]          Create/reset an admin login
  dashboard                     Print local and LAN dashboard URLs
  doctor                        Verify runtime compatibility and Hashcat visibility

Service:
  start | stop | restart        Control the background service
  status                        Show service status
  logs                          Follow service logs
  update                        Safe update from GitHub
  autostart                     Show boot autostart status
  autostart-on | autostart-off  Enable/disable boot autostart

Cracking:
  upload [opts] <capture...>    Upload one or more captures through the API
    --url URL                   Default: http://127.0.0.1:9111
    --user USER                 Default: admin
    --password PASSWORD         Otherwise prompted
    --password=PASSWORD         Safest form for shell-special passwords
    --wordlist SERVER_PATH      Server-side wordlist path, or None
    --rule RULE                 Rule name such as best64.rule, or None
    --workload normal|rainbow   Default: normal
    --brain                     Enable Hashcat Brain
    --device ID / --devices IDs Select specific Hashcat devices

Remote access:
  tailscale [auth-key]          Install/connect Tailscale
  cloudflare <host> [token]     Install/start Cloudflare Tunnel connector
  driver-check                  Check/install Linux NVIDIA/AMD GPU drivers when supported
  driver-status                 Show GPU/driver readiness

Uninstall:
  uninstall                     Interactive uninstall wizard, keeps data by default
  uninstall --yes               Remove app/service non-interactively, keep data
  uninstall --yes --purge-data  Remove app/service and delete data/logs
  reset                         Factory reset the configured data directory only, then restart
EOF
}

command="${1:-help}"
shift || true

case "$command" in
    setup)
        setup_wizard
        ;;
    set-login|password)
        set_login "$@"
        ;;
    update)
        echo "[*] Triggering safe automated update from GitHub..."
        curl -sL https://raw.githubusercontent.com/EpicNori/Hashcat-Pwnagotchi-server/main/update.sh | sudo bash
        ;;
    reset)
        echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
        echo "!!! WARNING: THIS WILL WIPE ALL USERS AND RESULTS !!!"
        echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
        echo "Data path: $DATA_DIR"
        if confirm "Are you sure you want a factory reset? [y/N]" "n"; then
            assert_safe_data_dir "$DATA_DIR"
            sudo systemctl stop "$SERVICE_NAME" || true
            if sudo test -d "$DATA_DIR"; then
                sudo find "$DATA_DIR" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
            fi
            sudo systemctl start "$SERVICE_NAME" || true
            echo "[+] Factory reset complete."
        fi
        ;;
    start|stop|restart)
        sudo systemctl "$command" "$SERVICE_NAME"
        ;;
    status)
        sudo systemctl status "$SERVICE_NAME"
        ;;
    autostart)
        sudo "$(script_path autostart_service.sh)" status
        ;;
    autostart-on)
        sudo "$(script_path autostart_service.sh)" enable
        ;;
    autostart-off)
        sudo "$(script_path autostart_service.sh)" disable
        ;;
    driver-check)
        sudo "$(script_path install_gpu_drivers.sh)" check
        ;;
    driver-status)
        sudo "$(script_path install_gpu_drivers.sh)" status
        ;;
    tailscale|tunnel-tailscale)
        tailscale_connect "$@"
        ;;
    cloudflare|tunnel-cloudflare)
        cloudflare_connect "$@"
        ;;
    upload)
        upload_files "$@"
        ;;
    doctor)
        sudo -u "$APP_USER" "$(script_path verify_runtime.sh)"
        ;;
    logs)
        sudo journalctl -u "$SERVICE_NAME" -f
        ;;
    uninstall)
        sudo \
            HASHCAT_WPA_APP_ROOT="$APP_ROOT" \
            HASHCAT_WPA_APP_USER="$APP_USER" \
            HASHCAT_WPA_DATA_DIR="$DATA_DIR" \
            HASHCAT_WPA_LOG_DIR="$LOG_DIR" \
            HASHCAT_WPA_SERVICE_NAME="$SERVICE_NAME" \
            "$(script_path uninstall_app.sh)" --wizard "$@"
        ;;
    dashboard)
        dashboard_urls
        ;;
    help|-h|--help)
        show_help
        ;;
    *)
        echo "[!] Unknown command: $command"
        echo ""
        show_help
        exit 2
        ;;
esac
